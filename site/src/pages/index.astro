---
// costql.com: landing page, implemented from the costQL Design System
// (vintage-computer + paper-receipt brand). Sections mirror the approved mock.
import BuildSteps from '../components/BuildSteps.astro';
import Hero from '../components/Hero.astro';
import PlaygroundSection from '../components/PlaygroundSection.astro';
import ProofStats from '../components/ProofStats.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Tiers from '../components/Tiers.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/brand-tokens.css';
import '../styles/brand.css';

const description =
  'costQL turns your GraphQL API into a pricing pack: one small file that prices any query before it runs, in Python or JavaScript, with no calls to a server.';

// Structured data (schema.org) so search engines model costQL as one entity:
// a free, open-source developer tool published by Shape Machine.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://costql.com/#website',
      url: 'https://costql.com/',
      name: 'costQL',
      description,
      publisher: { '@id': 'https://costql.com/#org' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://costql.com/#org',
      name: 'Shape Machine',
      url: 'https://costql.com/',
      sameAs: ['https://github.com/shapemachine'],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://costql.com/#software',
      name: 'costQL',
      description,
      url: 'https://costql.com/',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform (Python 3, Node.js)',
      softwareHelp: 'https://costql.com/docs/quickstart/',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      author: { '@id': 'https://costql.com/#org' },
      sameAs: ['https://github.com/shapemachine/costql'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>costQL: price GraphQL queries before they run</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://costql.com/" />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="costQL" />
    <meta property="og:url" content="https://costql.com/" />
    <meta property="og:title" content="costQL: price GraphQL queries before they run" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://costql.com/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="costQL: a paper receipt pricing a GraphQL query in work-ms."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="costQL: price GraphQL queries before they run" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://costql.com/og-card.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="cql">
    <SiteHeader />
    <main>
      <Hero />
      <ProofStats />
      <BuildSteps />
      <Tiers />
      <PlaygroundSection />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
