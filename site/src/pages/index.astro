---
// costql.com: landing page, implemented from the costQL Design System
// (vintage-computer + paper-receipt brand). Sections mirror the approved mock.
import BuildSteps from '../components/BuildSteps.astro';
import Hero from '../components/Hero.astro';
import PlaygroundSection from '../components/PlaygroundSection.astro';
import ProofStats from '../components/ProofStats.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Tiers from '../components/Tiers.astro';
import '../styles/brand-tokens.css';
import '../styles/brand.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>costQL: price GraphQL queries before you run them</title>
    <meta
      name="description"
      content="costQL turns your GraphQL API into a pricing pack: one small file that prices any query before you run it, in Python or JavaScript, with no calls to a server."
    />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="cql">
    <SiteHeader />
    <main>
      <Hero />
      <ProofStats />
      <BuildSteps />
      <Tiers />
      <PlaygroundSection />
    </main>
    <SiteFooter />
  </body>
</html>
