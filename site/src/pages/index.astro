---
// costql.com — landing page, implemented from the costQL Design System
// (vintage-computer + paper-receipt brand). Sections mirror the approved mock.
import BuildSteps from '../components/BuildSteps.astro';
import Hero from '../components/Hero.astro';
import PlaygroundSection from '../components/PlaygroundSection.astro';
import ProofStats from '../components/ProofStats.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Tiers from '../components/Tiers.astro';
import '../styles/brand-tokens.css';
import '../styles/brand.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>costQL — price GraphQL queries before you run them</title>
    <meta
      name="description"
      content="Calibrate a live GraphQL API into a static pricing pack, then quote any query offline — in Python or JavaScript. A safe billable ceiling in work-ms, never dollars."
    />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // apply the saved theme before paint; shared with the docs (Starlight)
      try {
        const t = localStorage.getItem('starlight-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
  </head>
  <body class="cql">
    <SiteHeader />
    <main>
      <Hero />
      <ProofStats />
      <BuildSteps />
      <Tiers />
      <PlaygroundSection />
    </main>
    <SiteFooter />
  </body>
</html>
