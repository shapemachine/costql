---
import PlaygroundSection from '../components/PlaygroundSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/brand-tokens.css';
import '../styles/brand.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>playground: costQL</title>
    <meta
      name="description"
      content="Write a GraphQL query and see its price instantly. The real costQL engine, loaded on this page with three ready-made packs."
    />
    <link rel="canonical" href="https://costql.com/playground/" />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="costQL" />
    <meta property="og:url" content="https://costql.com/playground/" />
    <meta property="og:title" content="costQL playground: price live GraphQL queries in your browser" />
    <meta
      property="og:description"
      content="Write a GraphQL query and see its price instantly. The real costQL engine, loaded on this page with three ready-made packs."
    />
    <meta property="og:image" content="https://costql.com/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="costQL: a paper receipt pricing a GraphQL query in work-ms."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="costQL playground: price live GraphQL queries in your browser" />
    <meta
      name="twitter:description"
      content="Write a GraphQL query and see its price instantly. The real costQL engine, loaded on this page with three ready-made packs."
    />
    <meta name="twitter:image" content="https://costql.com/og-card.png" />
  </head>
  <body class="cql">
    <SiteHeader />
    <main>
      <PlaygroundSection />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
