---
import Receipt from './Receipt.astro';
---

<section id="top" class="cql-container cql-hero">
  <div>
    <span class="cql-badge cql-badge--accent">GraphQL cost, quoted offline</span>
    <h1>Price GraphQL queries <span class="cql-mark"><em>before</em></span> you run them.</h1>
    <p>
      Point costQL at your API once.<br />
      It writes a <strong>pricing&nbsp;pack</strong>: one small
      file your app can use to price any query, instantly, with no calls to a server.
    </p>
    <div class="cql-hero__pills">
      {['pip install costql', 'npm install costql'].map((cmd) => (
        <button class="cql-pill" data-copy={cmd} title="copy to clipboard">
          <span class="cql-pill__prompt">$</span>
          <span>{cmd}</span>
          <span class="cql-pill__state" aria-hidden="true">
            <svg class="cql-pill__ic-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="12" height="12" rx="1.5" />
              <path d="M5 15H4a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 4 3h9A1.5 1.5 0 0 1 14.5 4.5V5" />
            </svg>
            <svg class="cql-pill__ic-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
        </button>
      ))}
    </div>
    <div class="cql-hero__ctas">
      <a href="#playground" class="cql-btn cql-btn--primary cql-btn--lg">Try the playground</a>
      <a href="/docs/quickstart/" target="_blank" rel="noopener" class="cql-btn cql-btn--secondary cql-btn--lg">Quickstart →</a>
    </div>
  </div>

  <div class="cql-hero__aside">
    <Receipt
      title="costql quote"
      meta="tmdb_t3.json · fully offline"
      items={[
        { label: 'movie(id)', value: '4.0' },
        { label: 'cast(limit:8)', value: '12.5' },
        { label: 'person.name ×8', value: '34.0', indent: true },
        { label: 'confidence', value: 'high', muted: true },
      ]}
      total="50.5"
      totalLabel="safe ceiling (work-ms)"
      footer="thank you for your query"
      width={320}
    />
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.cql-pill').forEach((pill) => {
    pill.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pill.dataset.copy || ''); } catch {}
      pill.classList.add('cql-pill--copied');
      setTimeout(() => pill.classList.remove('cql-pill--copied'), 1200);
    });
  });
</script>
