---
// "Which tier fits your API?": a stacked checklist in a modal. Each checked
// box implies a minimum tier; the fit is the highest one triggered, capped at
// T1 when the visitor can't change the server. Fit language only: no tier is
// ever called better, and every combination (including none) has an answer.
---

<dialog id="tier-finder" class="cql-modal" aria-labelledby="tier-finder-title">
  <form method="dialog" class="cql-modal__head">
    <h3 id="tier-finder-title" class="cql-modal__title">Which tier fits your API?</h3>
    <button class="cql-modal__close" aria-label="close">×</button>
  </form>

  <div class="cql-modal__body">
    <p class="cql-modal__intro">
      Five yes-or-no questions; the answer updates as you go.
      No tier is better than another. The fit is a fact about your API.
    </p>

    <div class="cql-finder__group">
      {[
        { key: 'owner', yes: true, q: 'Do you run the server?', hint: 'you could deploy a change to it' },
        { key: 'batch', yes: false, q: 'Does your API batch, coalesce, or cache reads?', hint: 'DataLoader, SELECT … WHERE id IN (…), an entity cache' },
        { key: 'parallel', yes: false, q: 'Does your API do work in parallel inside one request?', hint: 'concurrent downstream calls' },
        { key: 'external', yes: false, q: 'Does your API call outside paid services your app must price?', hint: 'an LLM, a licensed data feed' },
        { key: 'breakdown', yes: false, q: 'Do you want a per-field cost breakdown in every quote?', hint: '' },
      ].map(({ key, yes, q, hint }) => (
        <div class="cql-finder__q">
          <span class="cql-finder__qtext">{q}
            {hint && <small>{hint}</small>}</span>
          <span class="cql-finder__toggle">
            <label>
              <input type="radio" name={`tf-${key}`} value="yes" checked={yes} />
              <span>yes</span>
            </label>
            <label>
              <input type="radio" name={`tf-${key}`} value="no" checked={!yes} />
              <span>no</span>
            </label>
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="cql-finder__result" aria-live="polite">
    <span class="cql-finder__chip" id="tf-chip">T1</span>
    <p class="cql-finder__why" id="tf-why"></p>
  </div>

  <div class="cql-modal__foot">
    <a href="/docs/tiers/" target="_blank" rel="noopener">How the tiers see work →</a>
  </div>
</dialog>

<script is:inline>
  {
    const dialog = document.getElementById('tier-finder');
    const chip = document.getElementById('tf-chip');
    const why = document.getElementById('tf-why');

    const pulse = (el) => {
      el.classList.remove('cql-finder__pulse');
      void el.offsetWidth;
      el.classList.add('cql-finder__pulse');
    };

    let prev = '';
    const update = () => {
      const on = (k) => dialog.querySelector(`[name="tf-${k}"]:checked`).value === 'yes';
      const owner = on('owner');
      const batch = on('batch'), parallel = on('parallel'),
            external = on('external'), breakdown = on('breakdown');

      let tier, text;
      if (!owner) {
        tier = 'T1';
        text = "T1 asks nothing of a server you can't change, and it still quotes a safe max you can bill on.";
        if (batch || external) {
          text += ' Your other answers point at T3. If you ever get access to the server, instrument for that.';
        } else if (parallel || breakdown) {
          text += ' Your other answers point at T2. If you ever get access to the server, instrument for that.';
        }
      } else if (batch && external) {
        tier = 'T3';
        text = 'Your server reuses work and calls outside services. T3 prices the shared reads once, and it names each outside host so your app can price those calls.';
      } else if (batch) {
        tier = 'T3';
        text = 'Your server batches or reuses reads. T3 watches that sharing and prices the work once, instead of charging for every repeat.';
      } else if (external) {
        tier = 'T3';
        text = "T3 quotes name each outside host and its call count. Your app puts the price on those calls; costQL can't know what an outside service charges.";
      } else if (parallel && breakdown) {
        tier = 'T2';
        text = 'T2 times each resolver. That timing sees your parallel work and fills the per-field breakdown you want. You said no shared reads, so T3 has nothing extra to watch.';
      } else if (parallel) {
        tier = 'T2';
        text = 'Your API works in parallel, and one stopwatch on the whole request misses that. T2 times each resolver, so the price follows the real work. You said no shared reads, so T3 has nothing extra to watch.';
      } else if (breakdown) {
        tier = 'T2';
        text = 'T2 times each resolver, and that timing fills the per-field breakdown you want. You said no shared reads, so T3 has nothing extra to watch.';
      } else {
        tier = 'T1';
        text = 'Your API does its work one step at a time, and one stopwatch measures that well. T1 fits, even with the server yours to change.';
      }

      chip.textContent = tier;
      why.innerHTML = `<strong>Your fit: ${tier}.</strong> ${text}`;
      const next = `${tier}|${text}`;
      if (prev && prev !== next) { pulse(chip); pulse(why); }
      prev = next;
    };

    dialog.addEventListener('change', update);
    dialog.addEventListener('click', (e) => {
      // backdrop click closes: the dialog element itself is the click target
      if (e.target === dialog) dialog.close();
    });
    update();

    document.querySelectorAll('[data-open-tier-finder]').forEach((btn) =>
      btn.addEventListener('click', () => dialog.showModal()));
  }
</script>
