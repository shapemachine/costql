---
import Playground from './Playground.tsx';
---

<section id="playground" class="cql-container cql-section">
  <div class="cql-play__titlerow">
    <h2 class="cql-h2" style="margin: 0">Price your first query in 60 seconds</h2>
    <span class="cql-badge cql-badge--ink">no signup, no server</span>
  </div>
  <p class="cql-lead" style="margin-bottom: 28px">
    This is the real costQL engine, loaded on this page with three ready-made packs. Build
    a query from the schema on the left, or type your own: the price updates as you type.
  </p>

  <Playground client:only="react" />

  <div class="cql-play__ctas">
    <a href="/docs/quickstart/" class="cql-btn cql-btn--primary cql-btn--lg">Quickstart →</a>
    <a href="https://github.com/shapemachine/costql" class="cql-btn cql-btn--ink cql-btn--lg">Star on GitHub</a>
  </div>
</section>
